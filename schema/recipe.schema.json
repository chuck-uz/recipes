{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chuck-uz/recipes/schema/recipe.schema.json",
  "title": "Рецепт",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "description",
    "tags",
    "servings",
    "totalTimeMin",
    "ingredients",
    "steps",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "латиница и дефисы; совпадает с именем файла"
    },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 40 },
      "maxItems": 10
    },
    "servings": { "type": "integer", "minimum": 1, "maximum": 12 },
    "totalTimeMin": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "ingredients": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "unit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "unit": {
            "enum": ["g", "kg", "ml", "l", "tsp", "tbsp", "pinch", "pcs", "to_taste"],
            "description": "единицы cup не существует: объёмы в мл, сыпучее в граммах"
          },
          "scalable": {
            "type": "boolean",
            "description": "false — количество не пересчитывается при смене порций"
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 120 },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "timerSec": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400,
            "description": "только у шагов с реальным ожиданием"
          }
        }
      }
    },
    "notes": { "type": "string", "maxLength": 1000 },
    "createdAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": { "type": "string", "maxLength": 60 }
  }
}
